# Browser-safe project settings. The publishable key is public; RLS must protect
# every exposed table. Never add a Supabase secret/service-role key to VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development only: explicitly open the browser-local prototype when Supabase is unset.
VITE_STOCKPILOT_PROTOTYPE=true
